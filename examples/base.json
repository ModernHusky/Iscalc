        },
        {
            "level": 2,
            "name": "Trigonometric identities",
            "type": "header"
        },
        {
            "expr": "arctan(A) - arctan(B) = arctan((A-B)/(1+A*B))",
            "type": "axiom"
        },
        {
            "expr": "arctan(sqrt((1-x)/(1+x))) = arccos(x) / 2",
            "type": "axiom"
        },
        {
            "expr": "tan(a - b) = (tan(a) - tan(b)) / (1 + tan(a) * tan(b))",
            "type": "axiom"
        },
        {
            "attributes": [
                "simplify"
            ],
            "expr": "cos(2 * arctan(z)) = (1 - z^2) / (1 + z^2)",
            "type": "axiom"
        },
        {
            "attributes": [
                "simplify"
            ],
            "expr": "sin(2 * arctan(z)) = (2 * z) / (1 + z^2)",
            "type": "axiom"
        },
        {
            "expr": "arctan(x ^ -1) = pi/2 - arctan(x)",
            "type": "axiom"
        },
        {
            "attributes": [
                "simplify"
            ],
            "expr": "sin(2*arcsin(x)) = 2 * x * sqrt(1 - x^2)",
            "type": "axiom"
        },
        {
            "attributes": [],
            "conds": [],
            "expr": "arctan(-x) = -arctan(x)",
            "type": "axiom"
        },
        {
            "attributes": [
                "bidirectional"
            ],
            "expr": "1+sin(x) = (sin(x/2)+cos(x/2))^2",
            "type": "axiom"
        },
        {
            "attributes": [
                "bidirectional"
            ],
            "expr": "sin(x)+1 = (sin(x/2)+cos(x/2))^2",
            "type": "axiom"
        },
        {
            "attributes": [
                "bidirectional"
            ],
            "expr": "sin(x)+cos(x) = sqrt(2)*sin(x+pi/4)",
            "type": "axiom"
        },
        {
            "level": 2,
            "name": "Factorial and binomial coefficient",
            "type": "header"
        },
        {
            "expr": "(m + 1) * factorial(m) = factorial(m + 1)",
            "type": "axiom"
        },
        {
            "attributes": [
                "bidirectional"
            ],
            "expr": "m * factorial(m - 1) = factorial(m)",
            "type": "axiom"
        },
        {
            "expr": "binom(n, m) = factorial(n) / (factorial(m) * factorial(n-m))",
            "type": "definition"
        },
        {
            "expr": "binom(2*k+2, k+1) = 2 * binom(2*k, k) * ((2*k+1) / (k+1))",
            "type": "axiom"
        },
        {
            "expr": "(x+y)^n = SUM(k, 0, n, binom(n,k)*x^k*y^(n-k))",
            "type": "axiom"
        },
        {
            "attributes": [
                "simplify"
            ],
            "expr": "sgn(x) = 1",
            "type": "axiom",
            "conds": [
                "x > 0"
            ]
        },
        {
            "attributes": [
                "simplify"
            ],
            "expr": "sgn(x) = -1",
            "type": "axiom",
            "conds": [
                "x < 0"
            ]
        },
        {
            "attributes": [
                "simplify"
            ],
            "expr": "sgn(0) = 0",
            "type": "axiom"
        },
        {
            "attributes": [
                "simplify"
            ],
            "expr": "sgn(a) = 0",
            "type": "axiom",
            "conds": [
                "a = 0"
            ]
        },
        {
            "level": 1,
            "name": "Results from contour integration",
            "type": "header"
        },
        {
            "conds": [
                "a > 0",
                "m > 0"
            ],
            "expr": "(INT x:[0, oo]. sin(m * x) / (x * (a ^ 2 + x ^ 2))) = (pi * (1 - exp(-a * m))) / (2 * a ^ 2)",
            "reference": "Inside interesting Integrals, Section 8.10, C8.2",
            "type": "axiom"
        },
        {
            "conds": [
                "a > 0",
                "b > 0"
            ],
            "expr": "(INT x:[0, oo]. cos(a * x) / (x ^ 2 + b ^ 2)) = (pi / (2 * b)) * exp(-a * b)",
            "reference": "Inside interesting Integrals, Section 3.1.7",
            "type": "axiom"
        },
        {
            "level": 1,
            "name": "Summation split rules",
            "type": "header"
        },
        {
            "attributes": [
                "summation-split"
            ],
            "conds": [
                "a = l",
                "a < u"
            ],
            "expr": "SUM(n, l, u, f(n)) = f(a) + SUM(n, a+1, u, f(n))",
            "type": "axiom"
        },
        {
            "attributes": [
                "summation-split"
            ],
            "conds": [
                "a > l",
                "a <= u"
            ],
            "expr": "SUM(n, l, u, f(n)) = SUM(n, l, a-1, f(n)) + SUM(n, a, u, f(n))",
            "type": "axiom"
        },
        {
            "attributes": [
                "summation-split"
            ],
            "conds": [
                "a >= l",
                "a < u"
            ],
            "expr": "SUM(n, l, u, f(n)) = SUM(n, l, a, f(n)) + SUM(n, a+1, u, f(n))",
            "type": "axiom"
        },
        {
            "attributes": [
                "summation-split"
            ],
            "conds": [
                "a >= l",
                "a < u"
            ],
            "expr": "SUM(n, l, u, f(n)) = SUM(n, l, a, f(n)) + SUM(n, a+1, u, f(n))",
            "type": "axiom"
        },
        {
            "attributes": [
                "summation-split"
            ],
            "conds": [
                "a > l",
                "a <= u"
            ],
            "expr": "SUM(n, l, u, f(n)) = SUM(n, l, a-1, f(n)) + SUM(n, a, u, f(n))",
            "type": "axiom"
        },
        {
            "attributes": [
                "summation-split"
            ],
            "conds": [
                "a > l",
                "a < u"
            ],
            "expr": "SUM(n, l, u, f(n)) = SUM(n, l, a-1, f(n)) + f(a) + SUM(n, a+1, u, f(n))",
            "type": "axiom"
        },
        {
            "attributes": [
                "summation-split"
            ],
            "conds": [
                "a = l",
                "a < u"
            ],
            "expr": "SUM(n, l, u, f(n)) = f(a) + SUM(n, a+1, u, f(n))",
            "type": "axiom"
        },
        {
            "attributes": [
                "summation-split"
            ],
            "conds": [
                "a = u",
                "a > l"
            ],
            "expr": "SUM(n, l, u, f(n)) = SUM(n, l, a-1, f(n)) + f(u)",
            "type": "axiom"
        },
        {
            "attributes": [
                "summation-split"
            ],
            "expr": "SUM(n, 0, oo, f(n)) = SUM(n, 0, oo, f(2*n+1)) + SUM(n, 0, oo, f(2*n))",
            "type": "axiom"
        },
        {
            "level": 1,
            "name": "product split",
            "type": "header"
        },
        {
            "attributes": [
                "summation-split"
            ],
            "conds": [
                "a = u",
                "a > l"
            ],
            "expr": "MUL(n, l, u, f(n)) = MUL(n, l, u-1, f(n)) * f(u)",
            "type": "axiom"
        },
        {
            "attributes": [
                "summation-split"
            ],
            "conds": [
                "a = l",
                "a < u"
            ],
            "expr": "MUL(n, l, u, f(n)) = f(l) * MUL(n, l+1, u, f(n))",
            "type": "axiom"
        }
    ],
