{
    "content": [
        {
            "level": 1,
            "name": "Common identities",
            "type": "header"
        },
        {
            "attributes": [
                "bidirectional"
            ],
            "expr": "sin(x) = (exp(i*x) - exp(-i * x)) / (2*i)",
            "type": "axiom"
        },
        {
            "attributes": [
                "bidirectional"
            ],
            "conds": [
                "isReal(x)"
            ],
            "expr": "exp(i*x) = cos(x) + i * sin(x)",
            "type": "axiom"
        },
        {
            "level": 2,
            "name": "Hyperbolic functions",
            "type": "header"
        },
        {
            "expr": "cosh(x) = (exp(x) + exp(-x)) / 2",
            "type": "definition"
        },
        {
            "expr": "sinh(x) = (exp(x) - exp(-x)) / 2",
            "type": "definition"
        },
        {
            "level": 2,
